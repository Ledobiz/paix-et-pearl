# WhatsApp number that receives orders, international format, digits only (e.g. 2348012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Paystack — leave empty to hide card payment and use "Pay on WhatsApp" only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
